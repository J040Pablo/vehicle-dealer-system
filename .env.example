# Configuração das Variáveis de Ambiente do Vehicle Dealer System
# ATENÇÃO: Nunca comite o arquivo .env contendo segredos reais!

# Chave secreta JWT (OBRIGATÓRIO: mínimo de 32 bytes / 256 bits para algoritmo HS256)
# Exemplo de chave de 256 bits em formato Hexadecimal (64 caracteres hex = 32 bytes):
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250655368566D5971

# Tempo de expiração do Token JWT em milissegundos (86400000 ms = 24 horas)
JWT_EXPIRATION=86400000

# Conexão com o Banco de Dados PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/dealership_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgrespassword

# Origens permitidas para CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173
