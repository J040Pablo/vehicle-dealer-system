# ==============================================================================
# VEHICLE DEALER SYSTEM - CONFIGURAÇÃO DE VARIÁVEIS DE AMBIENTE (.env.example)
# ==============================================================================
# Copie este arquivo para '.env' na raiz do projeto antes de iniciar a aplicação:
#   cp .env.example .env
#
# ATENÇÃO: Nunca comite o arquivo '.env' contendo credenciais ou segredos reais!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SEGURANÇA E AUTENTICAÇÃO JWT (OBRIGATÓRIO)
# ------------------------------------------------------------------------------
# Chave secreta HMAC-SHA256 usada para assinar e validar tokens JWT.
# REGRA DE VALIDAÇÃO (JwtService.java):
#   - Não pode ser vazia ou nula.
#   - Deve possuir no MÍNIMO 32 bytes (256 bits) em UTF-8 (keyBytes.length >= 32).
#
# Para gerar uma nova chave segura de 256 bits no terminal (Linux/macOS):
#   openssl rand -hex 32
#
# Exemplo abaixo: 64 caracteres hexadecimais (64 bytes UTF-8 = 512 bits):
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250655368566D5971

# Tempo de expiração do Token JWT em milissegundos.
# Padrão: 86400000 ms (24 horas)
JWT_EXPIRATION=86400000

# ------------------------------------------------------------------------------
# 2. CONEXÃO COM BANCO DE DADOS POSTGRESQL
# ------------------------------------------------------------------------------
# Para execução via Docker Compose, a URL utiliza o hostname do container 'postgres':
#   SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/dealership_db
#
# Para execução local sem Docker (backend rodando no host):
#   SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/dealership_db
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/dealership_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgrespassword

# ------------------------------------------------------------------------------
# 3. POLÍTICA DE CORS (CROSS-ORIGIN RESOURCE SHARING)
# ------------------------------------------------------------------------------
# Origem permitida para requisições do frontend React (Vite dev server)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Base URL da API pública ViaCEP para consulta e preenchimento de endereços
VIACEP_URL=https://viacep.com.br/ws

# ------------------------------------------------------------------------------
# 5. CACHE DISTRIBUÍDO REDIS
# ------------------------------------------------------------------------------
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# TTLs do Cache (em minutos ou horas, configuráveis via propriedades)
SPRING_DATA_REDIS_TTL_DASHBOARD=5m
SPRING_DATA_REDIS_TTL_VIACEP=24h
SPRING_DATA_REDIS_TTL_VEHICLES=10m
SPRING_DATA_REDIS_TTL_DEALERS=10m
SPRING_DATA_REDIS_TTL_FILTERS=15m

